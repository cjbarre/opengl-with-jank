#!/usr/bin/env bash
set -euo pipefail

# Build the jank-engine dev runtime binary. This bundle intentionally depends
# on a compatible `jank` installation on PATH for LLVM/clang/JIT resources; it
# only packages the engine binary, engine-native dylibs, and headers needed by
# loose game source.

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

source "$SCRIPT_DIR/distribution-common.sh"
load_jank_paths

OUTPUT="jank-engine"
COMPILE_DIR="$PROJECT_DIR/target/engine"
BUILD_DIR="$PROJECT_DIR/dist/jank-engine"

run_lein_compile "$PROJECT_DIR" compile

# Assemble a fresh distribution without deleting lein-jank's build cache.
chmod -R u+w "$BUILD_DIR" 2>/dev/null || true
rm -rf "$BUILD_DIR"
python3 "$SCRIPT_DIR/bundle-native.py" "$COMPILE_DIR/$OUTPUT" "$BUILD_DIR" --dev

# Headers consumed by loose game source at JIT time.
mkdir -p "$BUILD_DIR/include"
cp -R "$COMPILE_DIR/_cache/engine-out-XXX/include/." "$BUILD_DIR/include/"
cp -R "$(pkg-config --variable=includedir glfw3)/GLFW" "$BUILD_DIR/include/"
if [[ "$PLATFORM_OS" == "linux" ]]; then
    cp -R "$(pkg-config --variable=includedir glew)/GL" "$BUILD_DIR/include/"
fi

for artifact in "$BUILD_DIR/bin/$OUTPUT" "$BUILD_DIR/lib/$OUTPUT/"*; do
    sanitize_embedded_build_paths "$artifact" "$PROJECT_DIR"
    if [[ "$PLATFORM_OS" == "macos" ]]; then
        codesign --force --sign - "$artifact"
    fi
done

cat > "$BUILD_DIR/${OUTPUT}_run" <<'LAUNCHER'
#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"

if ! command -v jank >/dev/null 2>&1; then
    echo "ERROR: jank-engine requires a compatible jank installation on PATH." >&2
    exit 1
fi

JANK_BIN="$(command -v jank)"
if command -v realpath >/dev/null 2>&1; then
    JANK_BIN="$(realpath "$JANK_BIN" 2>/dev/null || echo "$JANK_BIN")"
elif command -v readlink >/dev/null 2>&1; then
    JANK_BIN="$(readlink -f "$JANK_BIN" 2>/dev/null || echo "$JANK_BIN")"
fi

if [[ "$JANK_BIN" == */build/jank ]]; then
    JANK_DIR="${JANK_BIN%/build/jank}"
else
    JANK_DIR="$(cd "$(dirname "$JANK_BIN")/.." && pwd)"
fi

JANK_LLVM="${JANK_LLVM:-}"
if [[ -z "$JANK_LLVM" && "$(uname -s)" == "Darwin" ]]; then
    LLVM_LIBRARY="$(otool -L "$JANK_BIN" | awk '/libLLVM/ {print $1; exit}')"
    if [[ "$LLVM_LIBRARY" == /* ]]; then
        JANK_LLVM="$(dirname "$(dirname "$LLVM_LIBRARY")")"
    fi
fi
if [[ -z "$JANK_LLVM" && -d "$JANK_DIR/build/llvm-install/usr/local" ]]; then
    JANK_LLVM="$JANK_DIR/build/llvm-install/usr/local"
elif [[ -z "$JANK_LLVM" && -d /opt/homebrew/opt/llvm ]]; then
    JANK_LLVM="/opt/homebrew/opt/llvm"
elif [[ -z "$JANK_LLVM" && -d /usr/local/opt/llvm ]]; then
    JANK_LLVM="/usr/local/opt/llvm"
elif [[ -z "$JANK_LLVM" && -d /usr/lib/llvm-23 ]]; then
    JANK_LLVM="/usr/lib/llvm-23"
elif [[ -z "$JANK_LLVM" && -d /usr/lib/llvm-22 ]]; then
    JANK_LLVM="/usr/lib/llvm-22"
fi

if [[ -z "$JANK_LLVM" || ! -d "$JANK_LLVM/lib" ]]; then
    echo "ERROR: unable to locate installed jank LLVM libraries." >&2
    echo "       Set JANK_LLVM to the LLVM root used by your jank install." >&2
    exit 1
fi

if [[ -z "${CXX:-}" && -x "$JANK_LLVM/bin/clang++" ]]; then
    export CXX="$JANK_LLVM/bin/clang++"
fi
export PATH="$JANK_LLVM/bin:$PATH"

if [[ "$(uname -s)" == "Darwin" ]]; then
    find_lib_dir() {
        local lib_name="$1"
        shift
        for dir in "$@"; do
            if [[ -n "$dir" && -f "$dir/$lib_name" ]]; then
                echo "$dir"
                return 0
            fi
        done
        return 1
    }

    CRYPTO_DIR="${JANK_CRYPTO_DIR:-}"
    if [[ -z "$CRYPTO_DIR" ]]; then
        CRYPTO_DIR="$(find_lib_dir libcrypto.3.dylib \
            "$JANK_LLVM/lib" \
            "$JANK_DIR/build/llvm-install/usr/local/lib" \
            /opt/homebrew/opt/openssl@3/lib \
            /usr/local/opt/openssl@3/lib \
            2>/dev/null || true)"
    fi

    ZSTD_DIR="${JANK_ZSTD_DIR:-}"
    if [[ -z "$ZSTD_DIR" ]]; then
        ZSTD_DIR="$(find_lib_dir libzstd.1.dylib \
            "$JANK_LLVM/lib" \
            "$JANK_DIR/build/llvm-install/usr/local/lib" \
            /opt/homebrew/opt/zstd/lib \
            /usr/local/opt/zstd/lib \
            2>/dev/null || true)"
    fi

    if [[ -z "$CRYPTO_DIR" || -z "$ZSTD_DIR" ]]; then
        echo "ERROR: unable to locate jank support libraries." >&2
        echo "       Set JANK_CRYPTO_DIR and/or JANK_ZSTD_DIR if your jank install uses non-standard locations." >&2
        exit 1
    fi

    mkdir -p "$DIR/lib"
    rm -rf "$DIR/lib/jank-runtime"
    mkdir -p "$DIR/lib/jank-runtime"
    # Preserve the library names required by this jank version, including
    # versioned LLVM/clang names. C++ support libraries may live in subdirs.
    for dir in "$JANK_LLVM/lib" "$JANK_LLVM/lib/c++" "$JANK_LLVM/lib/unwind"; do
        for lib in "$dir/"*.dylib; do
            [[ -f "$lib" ]] || continue
            ln -sfn "$lib" "$DIR/lib/jank-runtime/$(basename "$lib")"
        done
    done
    ln -sfn "$CRYPTO_DIR" "$DIR/lib/jank-crypto"
    ln -sfn "$ZSTD_DIR" "$DIR/lib/jank-zstd"
    cleanup_runtime_links() {
        rm -rf "$DIR/lib/jank-runtime"
        rm -f "$DIR/lib/jank-crypto" "$DIR/lib/jank-zstd"
    }
    trap cleanup_runtime_links EXIT INT TERM

    # Do not prepend the installed jank LLVM/C++ runtime on macOS. The engine
    # binary resolves those deps through bundle-local rpath symlinks; overriding
    # DYLD_LIBRARY_PATH can mix incompatible C++ runtime images.
    DYLD_LIBRARY_PATH="$DIR/lib/jank-engine${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}" \
      "$DIR/bin/jank-engine" "$@"
else
    LIB_PATHS=("$DIR/lib/jank-engine" "$JANK_LLVM/lib")
    LD_LIBRARY_PATH="$(IFS=:; echo "${LIB_PATHS[*]}")${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
      exec "$DIR/bin/jank-engine" "$@"
fi
LAUNCHER
chmod +x "$BUILD_DIR/${OUTPUT}_run"

echo ""
echo "============================================================================="
echo "Built: $BUILD_DIR/${OUTPUT}_run"
echo ""
echo "Requires a compatible jank install on PATH for LLVM/clang/JIT resources."
echo ""
echo "Try it on an existing game:"
echo "  cd ../game"
echo "  ../engine/dist/jank-engine/${OUTPUT}_run . server"
echo ""
echo "Layout:"
echo "  dist/jank-engine/"
echo "  ├── bin/jank-engine          (executable)"
echo "  ├── lib/jank-engine/         (engine-native dylibs)"
echo "  ├── include/                 (headers for game cpp/raw)"
echo "  └── jank-engine_run          (launcher)"
echo "============================================================================="
