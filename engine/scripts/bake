#!/usr/bin/env bash
set -euo pipefail

# Bake a game into a standalone, self-contained binary.
#
# Unlike build-engine (which produces the jank-engine runtime that JIT-loads
# consumer source), bake AOT-compiles the engine + the game's source together
# into a single binary. The result needs nothing on the end user's machine -
# no XCode CLI tools, no jank installed, no headers, no LLVM/clang runtime.
#
# Full design, jank-source citations, failure modes, and verification recipe:
#   engine/docs/bake-distribution.md
# Read that before changing anything here or upgrading the jank submodule.
#
# Usage:
#   bake <game-dir> [-o <output-dir>]
#
# <game-dir> must contain project.clj configured for lein-jank and a
# jank-engine.edn with at least:
#   {:entry my-game.core
#    :paths ["src"]
#    :includes ["include"]      ; optional - dirs of *_impl.h
#    :name "my-game"            ; optional - defaults to first segment of :entry
#    :assets ["models" "ui"]}   ; optional - dirs copied into the bundle
#
# Default output: <game-dir>/dist/<name>

# Resolve symlinks to find actual script location
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

source "$SCRIPT_DIR/distribution-common.sh"
load_jank_paths

# =============================================================================
# Argument parsing
# =============================================================================
GAME_DIR=""
OUT_DIR_OVERRIDE=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o|--output) OUT_DIR_OVERRIDE="$2"; shift 2 ;;
        -h|--help)
            sed -n '3,17p' "$0" | sed 's|^# \?||'
            exit 0
            ;;
        -*) echo "Unknown flag: $1" >&2; exit 1 ;;
        *)
            if [[ -z "$GAME_DIR" ]]; then
                GAME_DIR="$1"
            else
                echo "Unexpected arg: $1" >&2; exit 1
            fi
            shift
            ;;
    esac
done

if [[ -z "$GAME_DIR" ]]; then
    echo "usage: bake <game-dir> [-o <output-dir>]" >&2
    exit 1
fi

GAME_DIR="$(cd "$GAME_DIR" && pwd)"
EDN="$GAME_DIR/jank-engine.edn"
PROJECT_CLJ="$GAME_DIR/project.clj"

if [[ ! -f "$EDN" ]]; then
    echo "ERROR: $EDN not found" >&2
    exit 1
fi

if [[ ! -f "$PROJECT_CLJ" ]]; then
    echo "ERROR: $PROJECT_CLJ not found" >&2
    echo "       Add a lein-jank project.clj with :main naming the baked entry namespace." >&2
    exit 1
fi

# =============================================================================
# Parse distribution settings with the Babashka already required by jank-build.
# =============================================================================
EDN_VARS="$(mktemp)"
trap 'rm -f "$EDN_VARS"' EXIT

bb -e '
(require (quote [clojure.edn :as edn])
         (quote [clojure.string :as str]))
(let [cfg (edn/read-string (slurp (first *command-line-args*)))
      entry (str (:entry cfg))
      name (or (:name cfg) (first (str/split entry #"\.")))
      q (str (char 39))
      esc #(str q (str/replace % q (str q "\\" q q)) q)]
  (println (str "ENTRY=" (esc entry)))
  (println (str "NAME=" (esc name)))
  (println (str "ASSETS=(" (str/join " " (map esc (:assets cfg []))) ")")))
' "$EDN" > "$EDN_VARS"

# shellcheck disable=SC1090
source "$EDN_VARS"

if [[ -z "${ENTRY:-}" || -z "${NAME:-}" ]]; then
    echo "ERROR: failed to parse $EDN" >&2
    exit 1
fi

OUT_DIR="${OUT_DIR_OVERRIDE:-$GAME_DIR/dist/$NAME}"
OUT_DIR="$(mkdir -p "$OUT_DIR" && cd "$OUT_DIR" && pwd)"

# =============================================================================
# Compile into a persistent lein-jank target; assemble the shipping bundle separately.
# =============================================================================
# Install the current engine source package before resolving the game dependency.
(cd "$PROJECT_DIR" && lein install)
run_lein_compile "$GAME_DIR" with-profile release compile --name "$NAME"

rm -rf "${OUT_DIR:?}/bin" "${OUT_DIR:?}/lib" "${OUT_DIR:?}/include"
python3 "$SCRIPT_DIR/bundle-native.py" "$GAME_DIR/target/release/$NAME" "$OUT_DIR" --name "$NAME"
for artifact in "$OUT_DIR/bin/$NAME" "$OUT_DIR/lib/$NAME/"*; do
    sanitize_embedded_build_paths "$artifact" "$GAME_DIR" "$OUT_DIR"
    if [[ "$PLATFORM_OS" == "macos" ]]; then
        codesign --force --sign - "$artifact"
    fi
done

# =============================================================================
# Bundle game assets
# =============================================================================
for asset in "${ASSETS[@]}"; do
    if [[ -z "$asset" || "$asset" == /* || "$asset" == *..* ]]; then
        echo "ERROR: invalid asset path in $EDN: $asset" >&2
        exit 1
    fi
    rm -rf "${OUT_DIR:?}/$asset"
    if [[ -d "$GAME_DIR/$asset" ]]; then
        cp -R "$GAME_DIR/$asset" "$OUT_DIR/$asset"
    else
        echo "WARNING: asset dir not found: $GAME_DIR/$asset" >&2
    fi
done

# =============================================================================
# Launcher: cd into the bundle (so asset paths resolve), point
# DYLD_LIBRARY_PATH at the bundled dylibs, exec the binary.
# =============================================================================
LAUNCHER="$OUT_DIR/${NAME}_run"
cat > "$LAUNCHER" <<LAUNCHER_EOF
#!/usr/bin/env bash
# Resolve own directory without depending on \`dirname\` / \`realpath\` being on
# PATH (pure-bash parameter expansion).
SELF="\${BASH_SOURCE[0]}"
case "\$SELF" in /*) ;; *) SELF="\$PWD/\$SELF" ;; esac
DIR="\${SELF%/*}"
export LD_LIBRARY_PATH="\$DIR/lib/$NAME:\${LD_LIBRARY_PATH:-}"
export DYLD_LIBRARY_PATH="\$DIR/lib/$NAME:\${DYLD_LIBRARY_PATH:-}"
cd "\$DIR"
exec "\$DIR/bin/$NAME" "\$@"
LAUNCHER_EOF
chmod +x "$LAUNCHER"

# =============================================================================
# Done
# =============================================================================
SIZE=$(du -sh "$OUT_DIR" | cut -f1)
echo ""
echo "============================================================================="
echo "Baked: $LAUNCHER ($SIZE)"
echo ""
echo "Run with:  $LAUNCHER [args...]"
echo ""
echo "Layout:"
echo "  $OUT_DIR/"
echo "    bin/$NAME              # AOT binary (engine + game source)"
echo "    lib/$NAME/             # bundled dylibs"
for asset in "${ASSETS[@]}"; do
    echo "    $asset/                 # game asset dir"
done
echo "    ${NAME}_run            # launcher"
echo "============================================================================="
